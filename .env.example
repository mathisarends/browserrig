# Credentials belong to the provider selected by your host application.
# Benchmarks default to the Codex subscription (codex login) and gpt-6.1-terra.
# These settings apply to the examples and benchmarks with --provider openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# BROWSERRIG_CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe

# Optional tracing: docker compose up -d --wait, then add --trace-content to the example.
# --trace captures metadata only; --trace-content includes model/tool inputs and outputs.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:6006/v1/traces
# OTEL_SERVICE_NAME=browserrig
# PHOENIX_PROJECT_NAME=browserrig
